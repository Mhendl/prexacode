# PREXAcode - Apache Config

# Proteger archivos de configuración
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Proteger base de datos, logs e includes internos (nunca servir por HTTP)
<FilesMatch "(\.(db|db-wal|db-shm|sqlite|sqlite3|log)|^_.*\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevenir listado de directorios
Options -Indexes

# Headers de seguridad (mod_headers puede no estar disponible en shared hosting)
<IfModule mod_headers.c>
    <FilesMatch "\.(php)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>

    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Habilitar compresión Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# CORS: los endpoints resuelven el origen permitido en PHP (api/_bootstrap.php)
